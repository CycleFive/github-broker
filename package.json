{
  "name": "github-broker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Remote MCP server on Cloudflare Workers that brokers a GitHub App installation without exposing its private key",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.157.0"
  }
}
